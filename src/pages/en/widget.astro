---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/lifeline-eligibility-checker/" title="Lifeline eligibility checker" width="100%" height="760" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/lifeline-companies/" title="Lifeline companies by state and ZIP code" width="100%" height="760" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free Lifeline eligibility checker on your website" description="Put the Lifeline eligibility checker or the company finder on the website of a food bank, library, clinic or housing agency: one iframe, no sign-up, no cookie, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a Lifeline tool</h1>
    <p class="mt-3 text-lg text-navy-700">For food banks, libraries, clinics, housing agencies and community groups that help people stay connected.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Lifeline eligibility checker</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Lifeline companies by state and ZIP code</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When a limit or the company list changes, the embedded tool updates itself. Nothing your visitors type reaches us and the frame sets no cookie. Each frame states that the site is independent and not the FCC, USAC or a phone company. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/lifeline-eligibility-checker/" title="Lifeline eligibility checker" width="100%" height="760" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
