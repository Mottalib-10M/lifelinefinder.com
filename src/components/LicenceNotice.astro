interface Props { class?: string }
const { class: cls = 'text-xs text-navy-500' } = Astro.props;
---
<p class={cls} data-licence-notice>
  Lifeline companies and subscriber counts: USAC Open Data, “Lifeline Companies Near Me” (public domain) and “Lifeline Disbursements” (CC0 1.0 public domain dedication); calculations by Radif Partners.
  Rules: Title 47 of the Code of Federal Regulations (eCFR), FCC and USAC publications and HHS poverty guidelines, US government works; FCC web pages read on archived copies of the Internet Archive where marked. Explanations and tools written by Radif Partners.
</p>
